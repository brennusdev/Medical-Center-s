# MED — Exemplo de variáveis de ambiente (copie para `.env`; NUNCA commite o .env real).
#
# REGRA DE SEGURANÇA (V9/V12): nenhum secret real vive no repositório.
# Em produção, use secret manager / GitHub Secrets / variáveis do orquestrador.

# --- V9/V12 — Aplicação ---
# Secret de assinatura dos JWT: gere um valor aleatório forte (ex.: `openssl rand -hex 32`).
SECRET_KEY=troque-este-valor-em-producao
# true (dev) = rotas legadas sem token continuam funcionando; false (prod) = tudo protegido.
ALLOW_LEGACY_AUTH=true
# Em DEBUG=true o logging sobe o nível; em produção NUNCA true (expõe detalhes).
DEBUG=false

# --- V12 — Banco de dados ---
# Dev local (padrão do projeto): SQLite. Em staging/produção use PostgreSQL.
DATABASE_URL=sqlite:///./medical_center.db
# Credenciais do Postgres do docker-compose (somente desenvolvimento).
POSTGRES_USER=med
POSTGRES_PASSWORD=med_dev_password
POSTGRES_DB=med

# --- V12 — Redis (cache/filas internas; nunca fonte da verdade) ---
REDIS_URL=redis://localhost:6379/0
